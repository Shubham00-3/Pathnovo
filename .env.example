# Copy to .env and fill in. Never commit a real key.

# Provider selection. `extractive` is the deterministic, no-key default and
# makes no network calls. Set to a LiteLLM provider id to use a hosted model
# (requires `pip install '.[llm]'`).
LLM_PROVIDER=extractive
LLM_MODEL=

# Only needed when LLM_PROVIDER points at a hosted model.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Writes prompts, responses, and raw questions into llm_calls.jsonl and
# chat.jsonl. Off by default: those artifacts otherwise carry document content
# and user questions in plaintext. Turn on only for local debugging.
CAPTURE_LLM_CONTENT=false

DELTA_CHAT_CONFIG=config/default.yaml
